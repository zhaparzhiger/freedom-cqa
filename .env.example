# Порт веб-сервера
PORT=8870

# ── Модель ────────────────────────────────────────────────────────────
# Вариант А: Vertex AI через сервисный аккаунт Google Cloud (путь к JSON-ключу)
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_LOCATION=global
# Вариант Б: ключ Google AI Studio (используется, если сервисный аккаунт не задан)
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.5-flash-lite
# Запасные модели, если основная перегружена (HTTP 429)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Режим оценки: agents — мультиагентный конвейер, single — один вызов
EVAL_MODE=agents
# Цена модели, $ за 1 млн токенов (для расчёта стоимости одной оценки). Сверьте с прайсом Google.
PRICE_INPUT_PER_M=0.25
PRICE_OUTPUT_PER_M=1.50

# Сколько независимых прогонов модели на один диалог (1 — быстро, 3 — голосование по большинству)
EVAL_VOTES=1
# Сколько диалогов оценивать параллельно при пакетной оценке
EVAL_CONCURRENCY=3

# ── API организаторов ─────────────────────────────────────────────────
# Полная GET-ссылка из Student Guide (кнопка «Открыть GET для DEV»).
# Параметр group_id подставляется автоматически, его значение в ссылке не важно.
ORG_API_URL=
